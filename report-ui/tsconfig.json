{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["vite/client", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/**/*.ts", "../tests/ui/**/*.tsx"]
}
